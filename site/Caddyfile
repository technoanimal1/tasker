{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# Canonical host: the bare domain redirects to www (canonicals + sitemap
	# point at https://www.thumbs.store).
	@apex host thumbs.store
	redir @apex https://www.thumbs.store{uri} permanent

	root * /srv
	encode gzip

	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header X-Frame-Options SAMEORIGIN

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /404.html
		file_server
	}

	file_server
}
